{
  "duration": 59.6,
  "cues": [
    {
      "start": 0.6,
      "end": 3.5,
      "text": "Сколько на самом деле стоит имущество?"
    },
    {
      "start": 4,
      "end": 7.9,
      "text": "Кто прав в споре, где у каждой стороны свои расчёты?"
    },
    {
      "start": 8.9,
      "end": 12.6,
      "text": "В сделке, в споре, в суде нужен не просто ответ,"
    },
    {
      "start": 12.9,
      "end": 16.1,
      "text": "а обоснованный вывод, оформленный документом."
    },
    {
      "start": 16.8,
      "end": 19.1,
      "text": "«Интегро» помогает разобраться:"
    },
    {
      "start": 19.4,
      "end": 24,
      "text": "оценка имущества, судебная экспертиза, экспертные исследования."
    },
    {
      "start": 24.7,
      "end": 29,
      "text": "В основе — анализ, специальные знания и требования закона."
    },
    {
      "start": 30.3,
      "end": 31.7,
      "text": "Как мы работаем."
    },
    {
      "start": 32.2,
      "end": 33.8,
      "text": "Вы описываете задачу."
    },
    {
      "start": 34.8,
      "end": 36.8,
      "text": "Мы изучаем её и материалы,"
    },
    {
      "start": 37.8,
      "end": 41,
      "text": "проводим необходимые исследования и расчёты"
    },
    {
      "start": 41.6,
      "end": 44.8,
      "text": "и готовим результат — отчёт или заключение."
    },
    {
      "start": 45.9,
      "end": 49.3,
      "text": "Вы получаете ясность, аргументированные выводы"
    },
    {
      "start": 49.6,
      "end": 53,
      "text": "и документ, который помогает решать вашу задачу."
    },
    {
      "start": 53.7,
      "end": 55.9,
      "text": "Расскажите о своей ситуации —"
    },
    {
      "start": 56.1,
      "end": 58.7,
      "text": "оставьте заявку на сайте «Интегро»."
    }
  ]
}
