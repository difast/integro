# Скопируйте в .env (локально) или задайте в панели Timeweb. Реальные значения не коммитьте.

# Основной домен сайта без завершающего слеша. Нужен на этапе СБОРКИ и при запуске:
# canonical, sitemap.xml, robots.txt, Open Graph. Если не задан, используется siteUrl из
# src/config/company.ts (https://intsoftholding.ru).
SITE_URL=https://intsoftholding.ru

# --- База заявок (PostgreSQL 13+) ---
# Все заявки с формы сохраняются в базу; без неё работает только отправка на почту (ниже).
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БАЗЫ
# Спецсимволы в пароле кодируются (например, @ → %40). Таблицы создаются автоматически при запуске.
DATABASE_URL=
# true — подключение по TLS с проверкой сертификата (для публичного адреса базы).
# Корневой сертификат провайдера можно передать в DATABASE_CA_CERT (PEM, переводы строк как \n).
# Не задано — без TLS (для приватной сети Timeweb).
# DATABASE_SSL=true
# DATABASE_CA_CERT=

# --- Панель заявок /admin ---
# Пароль входа, не короче 12 символов (рекомендуется 16+). Пустое значение — вход отключён.
# Хранится только в переменных окружения сервера; в базу и браузер не попадает.
ADMIN_PASSWORD=

# --- Уведомления о заявках на почту (SMTP), необязательно при подключённой базе ---
# Если база не подключена и SMTP не настроен, форма отключена и посетитель видит
# сообщение о том, что приём заявок через сайт не подключён.
SMTP_HOST=
# 465 — SSL (SMTP_SECURE=true), 587 — STARTTLS (SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя; по умолчанию используется SMTP_USER
MAIL_FROM=info@intsoftholding.ru
# Куда отправлять заявки; несколько адресов — через запятую
MAIL_TO=info@intsoftholding.ru

# Показать в production формулировки с пометкой draft (для согласования текстов).
# SHOW_DRAFT_CONTENT=true
