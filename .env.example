# Скопируйте в .env (локально) или задайте в панели Timeweb. Реальные значения не коммитьте.

# Основной домен сайта без завершающего слеша. Нужен на этапе СБОРКИ и при запуске:
# canonical, sitemap.xml, robots.txt, Open Graph. Если не задан, используется siteUrl из
# src/config/company.ts (https://intsoftholding.ru).
SITE_URL=https://intsoftholding.ru

# --- База заявок (PostgreSQL 13+) ---
# Все заявки с формы сохраняются в базу; без неё работает только отправка на почту (ниже).
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БАЗЫ?sslmode=require
# Пароль можно вставлять как есть, со спецсимволами (@ # ? / :), или в закодированном виде (%40 …).
# Таблицы создаются автоматически при запуске.
DATABASE_URL=
# TLS (параметр sslmode в адресе, как в libpq):
#   require     — шифрование без проверки сертификата (с DATABASE_CA_CERT — с проверкой цепочки);
#   verify-ca   — проверка цепочки по DATABASE_CA_CERT без сверки имени (для подключения по IP);
#   verify-full — полная проверка, включая имя хоста (то же, что DATABASE_SSL=true).
# Корневой сертификат базы Timeweb — в DATABASE_CA_CERT, в любом виде (многострочно или одной строкой).
# DATABASE_SSL=true
# DATABASE_CA_CERT=

# --- Панель заявок /admin ---
# Пароль входа, не короче 12 символов (рекомендуется 16+). Пустое значение — вход отключён.
# Хранится только в переменных окружения сервера; в базу и браузер не попадает.
ADMIN_PASSWORD=

# --- Уведомления о заявках на почту (SMTP), необязательно при подключённой базе ---
# Для отправки достаточно SMTP_HOST, SMTP_USER и SMTP_PASSWORD. Если база не подключена и SMTP не настроен, форма отключена и посетитель видит
# сообщение о том, что приём заявок через сайт не подключён.
SMTP_HOST=
# 465 — SSL (SMTP_SECURE=true), 587 — STARTTLS (SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя; по умолчанию используется SMTP_USER
MAIL_FROM=info@intsoftholding.ru
# Куда отправлять уведомления; несколько адресов — через запятую.
# Не задано — на почту компании из src/config/company.ts (info@intsoftholding.ru).
MAIL_TO=

# Показать в production формулировки с пометкой draft (для согласования текстов).
# SHOW_DRAFT_CONTENT=true

# --- Чат-бот MAX (подробно — MAX_INTEGRATION.md) ---
# Токен бота: выдаёт @MasterBot в MAX. Передаётся только в заголовке Authorization запросов к
# https://platform-api2.max.ru; в журналы, браузер и базу не попадает. Пусто — бот выключен.
MAX_BOT_TOKEN=
# Секрет Webhook: 32–256 символов (латинские буквы, цифры, «-», «_»), например результат
# команды `openssl rand -hex 32`. MAX присылает его в заголовке X-Max-Bot-Api-Secret;
# события без верного секрета отклоняются. Без секрета события не принимаются вовсе.
MAX_WEBHOOK_SECRET=
# Публичный HTTPS-адрес обработчика. Не задан — SITE_URL + /api/max/webhook
# (https://intsoftholding.ru/api/max/webhook).
MAX_WEBHOOK_URL=
# Необязательно: корневой сертификат (PEM) для platform-api2.max.ru — только если
# «Проверить подключение» в /admin/max/nastroyki сообщает об ошибке сертификата (TLS).
# MAX_API_CA_CERT=

# --- Telegram-бот (подробно — TELEGRAM_INTEGRATION.md) ---
# Токен от @BotFather. В Bot API токен входит в адрес запроса — адреса запросов не пишутся в журнал.
TELEGRAM_BOT_TOKEN=
# Секрет Webhook: 32–256 символов (латинские буквы, цифры, «-», «_»), например `openssl rand -hex 32`.
# Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token. Не используйте секрет MAX повторно.
TELEGRAM_WEBHOOK_SECRET=
# Публичный HTTPS-адрес обработчика. Не задан — SITE_URL + /api/telegram/webhook.
TELEGRAM_WEBHOOK_URL=
# Username бота без «@» (необязательно): ссылка на бота в админке и сверка с getMe.
TELEGRAM_BOT_USERNAME=

# --- Браузерные push-уведомления администратору (Web Push, подробно — ADMIN_OPERATIONS.md) ---
# Сгенерировать пару ключей: npx web-push generate-vapid-keys
# Публичный ключ передаётся браузеру при подписке; СЕКРЕТНЫЙ хранится только на сервере.
# Не заданы — push отключён, центр уведомлений в админке и Telegram работают.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт отправителя для push-сервисов: mailto:… или https://… По умолчанию — почта компании.
VAPID_SUBJECT=

# --- Резервное копирование базы (подробно — ADMIN_OPERATIONS.md) ---
# Ключ шифрования копий (AES-256-GCM): 64 hex-символа, `openssl rand -hex 32`.
# Храните отдельно от сервера (менеджер паролей): без ключа копию не восстановить.
# Не задан — копии не создаются.
BACKUP_ENCRYPTION_KEY=
# Внешнее S3-совместимое хранилище для ежедневных копий (например, объектное хранилище Timeweb Cloud).
# Все четыре обязательных поля заданы — автоматические копии включены; иначе только ручная выгрузка из админки.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ru-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Папка в хранилище (по умолчанию integro-backups/).
# BACKUP_S3_PREFIX=integro-backups/
# Час ежедневной копии по Москве (0–23) и срок хранения копий в днях.
BACKUP_HOUR_MSK=3
BACKUP_RETENTION_DAYS=30
